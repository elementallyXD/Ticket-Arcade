# Arc L1 Testnet Configuration
# Copy this file to .env and fill in your values

# Required - Your private key (without 0x prefix or with it)
PRIVATE_KEY=your_private_key_here

# Required - USDC token address on Arc testnet
# Option 1: Use Arc testnet USDC (if available)
# USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Option 2: Deploy your own MockUSDC for testing and set its address here
USDC_ADDRESS=0xYOUR_USDC_ADDRESS

# Optional - RPC URL (defaults to Arc testnet)
ARC_RPC_URL=https://rpc.testnet.arc.network

# Optional - Oracle address for Drand randomness delivery
# This is the address authorized to call deliverRandomness() on DrandRandomnessProvider
# If not set, defaults to the deployer address (PRIVATE_KEY)
# For testing: leave empty to use your deployer address
# For production: use a dedicated backend service address
ORACLE_ADDRESS=

# Optional - Maximum fee in basis points (default: 500 = 5%)
MAX_FEE_BPS=500

# ═══════════════════════════════════════════════════════════════════════════════
# TESTING CONFIGURATION (for test scripts)
# ═══════════════════════════════════════════════════════════════════════════════

# RaffleFactory contract address (after deployment)
RAFFLE_FACTORY_ADDRESS=0x8895f9297570B6199BC617885973F5790Fa773A4

# DrandRandomnessProvider contract address (after deployment)
RANDOMNESS_PROVIDER_ADDRESS=0x4af4721E1339DAb5C2484045d401C4A4290320C6
